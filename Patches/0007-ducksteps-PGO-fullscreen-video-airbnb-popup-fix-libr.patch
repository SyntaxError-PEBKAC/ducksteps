+// Airbnb: dismiss the "Got it" / X popup that blocks scrolling on load,
+// then hand off to _spa for the remainder.
+function _airbnb(dwellMs) {
+  var end = Date.now() + dwellMs;
+
+  // Dismiss popup — try "Got it" button text first, then top-right X.
+  // Airbnb renders the modal ~2-3s after page load.
+  setTimeout(function () {
+    try {
+      // Try "Got it" / "OK" button by text content
+      var btns = document.querySelectorAll('button');
+      var dismissed = false;
+      for (var i = 0; i < btns.length; i++) {
+        var t = btns[i].textContent.trim().toLowerCase();
+        if (t === 'got it' || t === 'ok' || t === 'okay' || t === 'close') {
+          btns[i].click();
+          dismissed = true;
+          break;
+        }
+      }
+      // Fallback: top-right X — aria-label or data-testid containing "close"
+      if (!dismissed) {
+        var closeBtn = document.querySelector(
+          '[aria-label*="close" i], [aria-label*="dismiss" i], ' +
+          '[data-testid*="close" i], [data-testid*="dismiss" i]'
+        );
+        if (closeBtn) closeBtn.click();
+      }
+    } catch (e) {}
+  }, 3000);
+
+  // Hand off to _spa after popup window — _longRead injected as dependency
+  setTimeout(function () {
+    var remaining = end - Date.now();
+    if (remaining > 5000) _spa(remaining);
+  }, 5000);
+}
