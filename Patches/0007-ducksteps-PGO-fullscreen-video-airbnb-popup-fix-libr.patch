+  // Fullscreen for 15s, then scroll for remainder
+  _enterFullscreen(function () {
+    var scrollStart = dwellMs * 0.6;
+    var end = Date.now() + dwellMs;
+    // Adjust remaining dwell — 19s already consumed by fullscreen phase
+    var remaining = dwellMs - 19000;
