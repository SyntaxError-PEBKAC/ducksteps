         upload_path = os.environ.get("UPLOAD_DIR")
+    # -- ducksteps: skip minidump processing outside Mozilla CI --
+    # MOZ_FETCHES_DIR is never set in local builds; crash reports are
+    # not actionable here anyway.
+    if not os.environ.get("MOZ_FETCHES_DIR"):
+        return 0
     if upload_path:
         # For automation, log the minidumps with stackwalk and get them moved to
