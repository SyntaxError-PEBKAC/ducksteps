+        # -- ducksteps: custom PGO training via WebExtension --
+        # The pgo_training extension drives the workload autonomously:
+        # background.js iterates through ~90 sites with realistic scroll
+        # behaviors and hot-path exercisers, then navigates to pgo_done.html
+        # which calls Quitter.quit() for a clean exit that flushes .profraw.
+        cmdargs = ["about:blank"]
         runner = FirefoxRunner(
             profile=profile,
             binary=binary,
@@ -262,17 +274,19 @@ if __name__ == "__main__":
             process_args=process_args,
         )
         runner.start(debug_args=debug_args, interactive=interactive)
-        try:
-            sys.path.insert(0, build.topsrcdir)
