                 "merge",
                 "-o",
                 merged_profdata,
-            ] + profraw_files
+                "@" + response_file,
+            ]
             rc = subprocess.call(merge_cmd)
+
             if rc != 0:
                 print("INFRA-ERROR: Failed to merge profile data. Corrupt profile?")
                 # exit with TBPL_RETRY
