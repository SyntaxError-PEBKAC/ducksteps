+            # when temporal profiling generates hundreds of profraw files.
+            # llvm-profdata supports @response_file syntax.
+            response_file = os.path.join(os.getcwd(), "profraw_files.txt")
+            with open(response_file, "w") as f:
+                for p in profraw_files:
+                    f.write(p + "\n")
             merge_cmd = [
