-        # user.js after the first (init) run completes, to prevent the init
-        # run from binding to port 2828 and causing a port conflict when the
-        # second (training) run launches.
+        # -- ducksteps: enable dump() so extension progress logs appear in stdout --
+        prefs["browser.dom.window.dump.enabled"] = True
+
+        # -- ducksteps: allow sideloaded extensions without prompt --
+        prefs["extensions.autoDisableScopes"] = 0
+
+        # -- ducksteps: allow unsigned extension (custom build, not enforced at compile time) --
+        prefs["xpinstall.signatures.required"] = False
+
+        # -- ducksteps: install training extension alongside Quitter via the proper addon install path --
+        training_ext = os.path.join(
+            build.topsrcdir, "build", "pgo", "pgo_training_extension"
+        )
 
         profile = FirefoxProfile(
             profile=profilePath,
@@ -177,14 +198,17 @@ if __name__ == "__main__":
             addons=[
                 os.path.join(
                     build.topsrcdir, "tools", "quitter", "quitter@mozilla.org.xpi"
-                )
+                ),
+                training_ext,
