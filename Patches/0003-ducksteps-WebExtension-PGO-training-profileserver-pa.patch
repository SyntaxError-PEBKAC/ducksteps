@@ -87,6 +93,12 @@ if __name__ == "__main__":
 
     build = MozbuildObject.from_environment()
 
+    # -- ducksteps: always write run logs to objdir, regardless of UPLOAD_PATH --
+    _log_dir = os.path.join(build.topobjdir, "pgo_logs")
+    os.makedirs(_log_dir, exist_ok=True)
+    if "UPLOAD_PATH" not in os.environ:
+        os.environ["UPLOAD_PATH"] = _log_dir
+
     binary = runner_args.get("binary")
     if not binary:
         try:
@@ -166,10 +178,19 @@ if __name__ == "__main__":
                 v = v.format(**interpolation)
             prefs[k] = Preferences.cast(v)
 
