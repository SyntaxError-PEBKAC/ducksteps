-        user_js = os.path.join(profilePath, "user.js")
-        with open(user_js, "a") as f:
-            f.write('\n// ducksteps: Marionette prefs for custom PGO training\n')
-            f.write('user_pref("marionette.enabled", true);\n')
-            f.write('user_pref("marionette.port", 2828);\n')
-            f.write('user_pref("dom.max_script_run_time", 0);\n')
-
-        # Brief pause to ensure port 2828 is fully released from init run
-        time.sleep(2)
-
