@@ -0,0 +1,208 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+"""Fade the edges of the ducksteps logo so it does not end on a hard cut.
+
+The source artwork runs straight off its own frame: on about-logo@2x.png,
+195 rows of fully opaque pixels sit against the right edge, slicing through
+the middle of the silver swoosh. Against a dark backdrop that reads as a
+sharp vertical seam rather than as artwork.
+
+This applies two fades, kept deliberately independent:
+
+  * an outline feather along the artwork's real silhouette, so the icon melts
+    into the backdrop instead of ending on a crisp vector edge;
+  * a wider fade down the right-hand side, following a shallow arc, so the
+    swoosh dissolves where it is cut rather than stopping dead.
+
+The right frame edge is NOT treated as a silhouette boundary. The arc already
+owns it, and seeding both there makes the fades compound: the silver loses its
+brightness early and reads as a grey smear against the navy, which looks worse
+than the hard edge it replaces.
+
+RGB is never touched. Only alpha moves.
+
+Run with no arguments to regenerate every branding asset that carries the cut:
+
+    python browser/branding/ducksteps/soften.py
+
+The transform is not idempotent - running it twice eats the artwork - so it
+refuses to touch a file that already looks softened unless given --force.
+"""
+
+import argparse
+import base64
+import io
+import math
+import pathlib
+import re
+import sys
+
+from PIL import Image, ImageFilter
+
+# Feather geometry, quoted for a 384px-wide image; soften() scales it to fit.
+OUTLINE = 14.0  # width of the all-round silhouette feather
+ARC_R = 680.0  # radius of the right-hand fade's arc; see soften()
+ARC_CY = 160.0  # arc centre, vertically: the middle of the cut region
+ARC_W = 26.0  # width of the right-hand fade
+REF = 384.0
+
+ALPHA_FLOOR = 8  # below this, an artwork pixel counts as outside
+
+# Assets carrying the same cut, relative to this file. The last is a PNG in an
+# SVG wrapper rather than a plain image.
+TARGETS = [
+    "content/about-logo.png",
+    "content/about-logo@2x.png",
+    "content/about-logo-private.png",
+    "content/about-logo-private@2x.png",
+    "content/about-logo.svg",
+]
+
+_SVG_EMBED = re.compile(r'(href="data:image/png;base64,)([^"]+)(")')
+
+
+def smoothstep(t):
+    t = 0.0 if t < 0 else (1.0 if t > 1 else t)
+    return t * t * (3 - 2 * t)
+
+
+def outline_falloff(im, width):
+    """Per-pixel 0..1 factor reaching 0 at the outline and 1 `width` px inside.
+
+    Derived from a Gaussian-blurred silhouette rather than a distance
+    transform: a chamfer distance quantises, and its contours visibly staircase
+    wherever the boundary runs close to horizontal, which shows up as a comb
+    along the top of the swoosh.
+
+    The mask is padded with transparency on the left, top and bottom, so
+    artwork cut off by those frame edges is treated as having a boundary there.
+    The right is left unpadded, so the blur clamps and the arc feather is the
+    only thing acting on that side.
+    """
+    width_px, height_px = im.size
+    sigma = max(width / 1.65, 0.5)
+    pad = int(math.ceil(3 * sigma))
+
+    mask = im.getchannel("A").point(lambda a: 255 if a > ALPHA_FLOOR else 0)
+    padded = Image.new("L", (width_px + pad, height_px + 2 * pad), 0)
+    padded.paste(mask, (pad, pad))
+    blurred = padded.filter(ImageFilter.GaussianBlur(sigma)).crop(
+        (pad, pad, pad + width_px, pad + height_px)
+    )
+
+    # 0.5 is the boundary itself; 0.95 is far enough in to count as solid.
+    lut = [smoothstep((v / 255.0 - 0.5) / 0.45) for v in range(256)]
+    return blurred.load(), lut
+
+
+def looks_softened(im):
+    """True if the right frame edge has already been faded out.
+
+    Stock artwork is fully opaque against that edge; a softened copy is not.
+    """
+    width_px, height_px = im.size
+    alpha = im.getchannel("A").load()
+    return max(alpha[width_px - 1, y] for y in range(height_px)) < 32
+
+
+def soften(im, outline=OUTLINE, arc_r=ARC_R, arc_cy=ARC_CY, arc_w=ARC_W, ref=REF):
+    """Return `im` with its edges faded. Mutates and returns the image.
+
+    arc_r has to stay large. It sets how far the right-hand fade curves inward
+    as it moves away from the arc centre, and the swoosh is at its widest and
+    brightest near the top of the cut - a tight arc pulls the fade in far
+    enough there to eat the band instead of just softening where it stops.
+    """
+    width_px, height_px = im.size
+    scale = width_px / ref
+    outline *= scale
+    arc_r *= scale
+    arc_cy *= scale
+    arc_w *= scale
+
+    px = im.load()
+    blurred, lut = outline_falloff(im, outline)
+    cx = width_px - arc_r
+
+    for y in range(height_px):
+        dy = y - arc_cy
+        xe = cx + math.sqrt(max(arc_r * arc_r - dy * dy, 0.0))
+        x0 = xe - arc_w
+        for x in range(width_px):
+            alpha = px[x, y][3]
+            if alpha == 0:
+                continue
+            factor = lut[blurred[x, y]]
+            if x > x0:
+                factor *= 1.0 - smoothstep((x - x0) / arc_w)
+            if factor < 1.0:
+                r, g, b, _ = px[x, y]
+                px[x, y] = (r, g, b, int(round(alpha * factor)))
+    return im
+
+
+def _process_png(path, force):
+    im = Image.open(path).convert("RGBA")
+    if looks_softened(im) and not force:
+        return False, "already softened"
+    before = path.stat().st_size
+    soften(im).save(path, optimize=True)
+    return True, f"{before / 1024:.0f} KB -> {path.stat().st_size / 1024:.0f} KB"
+
+
+def _process_svg(path, force):
+    """about-logo.svg is a base64 PNG in an SVG wrapper, and carries the cut."""
+    svg = path.read_bytes().decode("utf-8")
+    match = _SVG_EMBED.search(svg)
+    if not match:
+        return False, "no embedded PNG found"
+    im = Image.open(io.BytesIO(base64.b64decode(match.group(2)))).convert("RGBA")
+    if looks_softened(im) and not force:
+        return False, "already softened"
+    before = path.stat().st_size
+    buf = io.BytesIO()
+    soften(im).save(buf, format="PNG", optimize=True)
+    encoded = base64.b64encode(buf.getvalue()).decode()
+    path.write_bytes(
+        (svg[: match.start(2)] + encoded + svg[match.end(2) :]).encode("utf-8")
+    )
+    return True, f"{before / 1024:.0f} KB -> {path.stat().st_size / 1024:.0f} KB"
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument(
+        "files",
+        nargs="*",
+        help="images to soften; defaults to the branding assets that need it",
+    )
+    parser.add_argument(
+        "--force",
+        action="store_true",
+        help="soften even if the file already looks softened (it will stack)",
+    )
+    args = parser.parse_args(argv)
+
+    here = pathlib.Path(__file__).resolve().parent
+    paths = (
+        [pathlib.Path(f) for f in args.files]
+        if args.files
+        else [here / t for t in TARGETS]
+    )
+
+    failed = False
+    for path in paths:
+        if not path.exists():
+            print(f"  {path.name:26s} missing", file=sys.stderr)
+            failed = True
+            continue
+        handler = _process_svg if path.suffix.lower() == ".svg" else _process_png
+        changed, note = handler(path, args.force)
+        print(f"  {path.name:26s} {'' if changed else 'skipped: '}{note}")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
