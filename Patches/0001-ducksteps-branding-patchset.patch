@@ -0,0 +1,8 @@
+[App]
+Name=ducksteps
+Vendor=SyntaxError-PEBKAC
+AppID=ducksteps@local
+Version=1.1
+BuildID=20260115
+RemotingName=ducksteps
+RemotingUUID={f3b9c2d4-7a1e-4b6a-9f2e-8c4d1a0b6e72}
\ No newline at end of file
diff --git a/browser/app/nsBrowserApp.cpp b/browser/app/nsBrowserApp.cpp
index 4c5982c056fd..b4ad503de200 100644
--- a/browser/app/nsBrowserApp.cpp
+++ b/browser/app/nsBrowserApp.cpp
@@ -142,7 +142,7 @@ static MOZ_FORMAT_PRINTF(1, 2) void Output(const char* fmt, ...) {
       decltype(MessageBoxW)* messageBoxW =
           (decltype(MessageBoxW)*)GetProcAddress(user32, "MessageBoxW");
       if (messageBoxW) {
-        messageBoxW(nullptr, wide_msg, L"Firefox",
+        messageBoxW(nullptr, wide_msg, L"ducksteps",
                     MB_OK | MB_ICONERROR | MB_SETFOREGROUND);
       } else {
         showMessageBox = false;
@@ -198,7 +198,7 @@ static bool HasFlag(int argc, char* argv[], const char* s) {
 constinit Bootstrap::UniquePtr gBootstrap;
 
 static int do_main(int argc, char* argv[], char* envp[]) {
-  // Allow firefox.exe to launch XULRunner apps via -app <application.ini>
+  // Allow ducksteps.exe to launch XULRunner apps via -app <application.ini>
   // Note that -app must be the *first* argument.
   const char* appDataFile = getenv("XUL_APP_FILE");
   if ((!appDataFile || !*appDataFile) && (argc > 1 && IsFlag(argv[1], "app"))) {
@@ -432,7 +432,7 @@ int main(int argc, char* argv[], char* envp[]) {
 #  endif
 #  if defined(XP_WIN)
     // Ideally, we would be able to set our DPI awareness in
-    // firefox.exe.manifest Unfortunately, that would cause Win32k calls when
+    // ducksteps.exe.manifest Unfortunately, that would cause Win32k calls when
     // user32.dll gets loaded, which would be incompatible with Win32k Lockdown
     //
     // MSDN says that it's allowed-but-not-recommended to initialize DPI
@@ -499,7 +499,7 @@ int main(int argc, char* argv[], char* envp[]) {
 
 #if defined(XP_WIN)
 
-  // Ideally, we would be able to set our DPI awareness in firefox.exe.manifest
+  // Ideally, we would be able to set our DPI awareness in ducksteps.exe.manifest
   // Unfortunately, that would cause Win32k calls when user32.dll gets loaded,
   // which would be incompatible with Win32k Lockdown
   //
