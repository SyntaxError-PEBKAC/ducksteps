+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#aboutDialogContainer {
+  background-color: #20123a;
+  color: #fff;
+  color-scheme: dark;
+}
+
+#rightBox {
+  margin-inline: 30px;
+}
+
+#bottomBox {
+  background-color: hsla(235, 43%, 10%, .5);
