Subject: [PATCH 04/22] ducksteps: remove UPX from SFX stub (VT false positive
 fix)

---
 .../mozbuild/action/exe_7z_archive.py         | 29 ++++---------------
 1 file changed, 5 insertions(+), 24 deletions(-)

diff --git a/python/mozbuild/mozbuild/action/exe_7z_archive.py b/python/mozbuild/mozbuild/action/exe_7z_archive.py
index fc490157f91c..d6046dffac1c 100644
--- a/python/mozbuild/mozbuild/action/exe_7z_archive.py
+++ b/python/mozbuild/mozbuild/action/exe_7z_archive.py
@@ -20,27 +20,10 @@ def archive_exe(pkg_dir, tagfile, sfx_package, package, use_upx):
         if pkg_dir:
             shutil.move(pkg_dir, "core")
 
-        if use_upx:
-            final_sfx = mozpath.join(tmpdir, "7zSD.sfx")
-            upx = buildconfig.substs.get("UPX", "upx")
-            wine = buildconfig.substs.get("WINE")
-            if wine and upx.lower().endswith(".exe"):
-                cmd = [wine, upx]
-            else:
-                cmd = [upx]
-            subprocess.check_call(
-                cmd
-                + [
-                    "--best",
-                    "--lzma",
-                    "--ultra-brute",
-                    "-o",
-                    final_sfx,
-                    sfx_package,
-                ]
-            )
-        else:
-            final_sfx = sfx_package
+        # -- ducksteps: skip UPX on SFX stub -- UPX compression triggers
+        # Malwarebytes AI heuristic false positives regardless of flag choice.
+        # The stub is ~230KB; size savings aren't worth the VT noise.
+        final_sfx = sfx_package
 
         try:
             sevenz = buildconfig.config.substs["7Z"]
@@ -86,6 +69,4 @@ def main(args):
 
 
 if __name__ == "__main__":
-    sys.exit(main(sys.argv[1:]))
-
-
+    sys.exit(main(sys.argv[1:]))
