+
+  <!-- Twinkling glints -->
+  <g transform="translate(72,66) scale(7.5)" class="tw-a" style="animation-delay:-.4s"><use href="#sp" class="flare" style="animation-delay:-.4s"/></g>
+  <g transform="translate(498,40) scale(5.5)" class="tw-a" style="animation-delay:-2.9s;animation-duration:5.2s"><use href="#sp" class="flare" style="animation-delay:-2.9s;animation-duration:5.2s"/></g>
+  <g transform="translate(700,92) scale(6)" class="tw-b" style="animation-delay:-1.6s"><use href="#sp" class="flare" style="animation-delay:-1.6s;animation-duration:5.8s"/></g>
+  <g transform="translate(236,330) scale(6.5)" class="tw-b" style="animation-delay:-4.1s;animation-duration:6.4s"><use href="#sp" class="flare" style="animation-delay:-4.1s;animation-duration:6.4s"/></g>
+  <g transform="translate(556,300) scale(5.5)" class="tw-c" style="animation-delay:-3.3s"><use href="#sp"/></g>
