 @media not ((prefers-contrast) and (prefers-color-scheme: light)) {
   #aboutDialogContainer {
-    background-color: #20123a;
+    /* about-background.svg is drawn from the icon's own palette, so the icon
+       stops sitting on a flat field and starts sitting in a picture. The
