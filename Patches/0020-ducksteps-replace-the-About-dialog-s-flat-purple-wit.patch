+  <use href="#sp" class="tw-b" transform="translate(612,176) scale(4)"   style="animation-delay:-3.8s"/>
+  <use href="#sp" class="tw-c" transform="translate(94,344)  scale(4.2)" style="animation-delay:-.9s"/>
+  <use href="#sp" class="tw-c" transform="translate(392,320) scale(3.4)" style="animation-delay:-5.6s"/>
+  <use href="#sp" class="tw-b" transform="translate(724,208) scale(4.5)" style="animation-delay:-2.6s;animation-duration:6.6s"/>
+  <use href="#sp" class="tw-c" transform="translate(10,174)  scale(3.6)" style="animation-delay:-6.2s"/>
+  <use href="#sp" class="tw-c" transform="translate(330,24)  scale(3)"   style="animation-delay:-3.1s"/>
+  <use href="#sp" class="tw-c" transform="translate(662,340) scale(3.8)" style="animation-delay:-4.4s"/>
+  <use href="#sp" class="tw-c" transform="translate(252,130) scale(3.2)" style="animation-delay:-1.9s"/>
+</svg>
diff --git a/browser/branding/ducksteps/content/aboutDialog.css b/browser/branding/ducksteps/content/aboutDialog.css
