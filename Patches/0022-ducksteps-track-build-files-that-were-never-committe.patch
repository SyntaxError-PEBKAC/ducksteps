diff --git a/package.sh b/package.sh
new file mode 100644
index 000000000000..c21c34dddc46
--- /dev/null
+++ b/package.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -e
+
+if [[ -z "$1" ]]; then
+  echo "ERROR: objdir is required. Usage: ./package.sh <objdir>" >&2
+  exit 1
+fi
+if [[ ! -d "$1" ]]; then
+  echo "ERROR: objdir does not exist: $1" >&2
+  exit 1
+fi
+OBJDIR="$1"
+
+python mach package
+
+# Upstream moved the installer between ESR lines, so check both layouts.
+# toolkit/mozapps/installer/upload-files.mk on 140:
+#   INSTALLER_PACKAGE = $(DIST)/$(PKG_INST_PATH)$(PKG_INST_BASENAME).exe  -> dist/install/sea/
+# 153 changed that to $(PKG_PATH), which is empty for en-US builds:
+#   INSTALLER_PACKAGE = $(DIST)/$(PKG_PATH)$(PKG_INST_BASENAME).exe       -> dist/
+# Newest layout first, old path kept as a fallback.
+INSTALLER=$(ls "$OBJDIR/dist/firefox-"*.win64.installer.exe \
+               "$OBJDIR/dist/install/sea/firefox-"*.win64.installer.exe 2>/dev/null | head -1)
+if [[ -z "$INSTALLER" ]]; then
+  echo "ERROR: installer exe not found in $OBJDIR/dist/ or $OBJDIR/dist/install/sea/"
+  exit 1
+fi
+echo "Done: $INSTALLER"
\ No newline at end of file
-- 
