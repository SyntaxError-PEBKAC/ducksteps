 }
 
+async function showDuckstepsReleaseStatus() {
+  const { DuckstepsReleaseCheck } = ChromeUtils.importESModule(
+    "resource:///modules/DuckstepsReleaseCheck.sys.mjs"
+  );
+  let status = await DuckstepsReleaseCheck.getStatus();
+  let text = document.getElementById("duckstepsReleaseText");
+  let link = document.getElementById("duckstepsReleaseLink");
+  if (status.state == "available") {
+    text.value = `ducksteps ${status.version} is available.`;
+    link.value = "Download";
+    link.href = status.url;
+    link.hidden = false;
+  } else if (status.state == "current") {
+    text.value = "ducksteps is up to date.";
+  } else {
+    return;
+  }
+  document.getElementById("duckstepsReleaseStatus").hidden = false;
+}
+
