diff --git a/browser/modules/DuckstepsReleaseCheck.sys.mjs b/browser/modules/DuckstepsReleaseCheck.sys.mjs
new file mode 100644
index 000000000000..ec2942e4ad16
--- /dev/null
+++ b/browser/modules/DuckstepsReleaseCheck.sys.mjs
@@ -0,0 +1,233 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+
+ChromeUtils.defineESModuleGetters(lazy, {
+  BrowserWindowTracker: "resource:///modules/BrowserWindowTracker.sys.mjs",
+  clearTimeout: "resource://gre/modules/Timer.sys.mjs",
+  setTimeout: "resource://gre/modules/Timer.sys.mjs",
+});
+
+const PREF_ENABLED = "ducksteps.releasecheck.enabled";
+const PREF_URL = "ducksteps.releasecheck.url";
+const PREF_LAST_CHECK = "ducksteps.releasecheck.lastCheck";
+const PREF_LATEST = "ducksteps.releasecheck.latestVersion";
+const PREF_DISMISSED = "ducksteps.releasecheck.dismissedVersion";
+
+const RELEASE_PAGE_BASE =
+  "https://github.com/SyntaxError-PEBKAC/ducksteps/releases/tag/";
+const NOTIFICATION_ID = "ducksteps-new-release";
+
+const CHECK_INTERVAL_MS = 24 * 60 * 60 * 1000;
+const RETRY_INTERVAL_MS = 60 * 60 * 1000;
+const FETCH_TIMEOUT_MS = 10 * 1000;
+const MAX_RESPONSE_CHARS = 1000000;
+
+const VERSION_PATTERN = /^\d{1,4}(?:\.\d{1,4}){1,3}$/;
+const LOCAL_TEST_HOSTS = ["localhost", "127.0.0.1"];
+
+function isAllowedApiUrl(spec) {
+  try {
+    let uri = Services.io.newURI(spec);
+    return (
+      uri.scheme == "https" ||
+      (uri.scheme == "http" && LOCAL_TEST_HOSTS.includes(uri.host))
+    );
+  } catch (ex) {
+    return false;
+  }
+}
+
+/**
+ * Tells the user when a newer ducksteps release has been published on GitHub.
+ * It only reads the version number of the latest release and links to that
+ * release's page on the ducksteps repository. It never downloads or installs
+ * anything.
+ */
+export const DuckstepsReleaseCheck = {
+  _timer: null,
+  _pending: null,
+
+  get enabled() {
+    return Services.prefs.getBoolPref(PREF_ENABLED, true);
+  },
+
+  init() {
+    if (!this.enabled) {
+      return;
+    }
+    this.notifyIfNewer();
+    let last = Number(Services.prefs.getStringPref(PREF_LAST_CHECK, "0"));
+    let now = Date.now();
+    if (!Number.isFinite(last) || last > now) {
+      last = 0;
+    }
+    this._schedule(Math.max(0, last + CHECK_INTERVAL_MS - now));
+  },
+
+  _schedule(delayMs) {
+    lazy.clearTimeout(this._timer);
+    this._timer = lazy.setTimeout(async () => {
+      let version = await this.check();
+      this._schedule(version ? CHECK_INTERVAL_MS : RETRY_INTERVAL_MS);
+    }, delayMs);
+  },
+
+  /**
+   * Fetches the latest release version and stores it in prefs.
+   *
+   * @param {object} [options]
+   * @param {boolean} [options.notify=true]
+   *   Show the notification bar if the release is newer than this build.
+   * @returns {Promise<string|null>}
+   *   The latest published version, or null if the check did not succeed.
+   */
+  async check({ notify = true } = {}) {
+    if (!this.enabled || Services.io.offline) {
+      return null;
+    }
+    this._pending ??= this._fetchLatest().finally(() => {
+      this._pending = null;
+    });
+    let version = await this._pending;
+    if (version && notify) {
+      this.notifyIfNewer();
+    }
+    return version;
+  },
+
+  async _fetchLatest() {
+    let url = Services.prefs.getStringPref(PREF_URL, "");
+    if (!isAllowedApiUrl(url)) {
+      return null;
+    }
+
+    let controller = new AbortController();
+    let timer = lazy.setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
+    try {
+      let response = await fetch(url, {
+        credentials: "omit",
+        cache: "no-store",
+        referrerPolicy: "no-referrer",
+        headers: { Accept: "application/vnd.github+json" },
+        signal: controller.signal,
+      });
+      if (!response.ok || !isAllowedApiUrl(response.url)) {
+        return null;
+      }
+      let text = await response.text();
+      if (text.length > MAX_RESPONSE_CHARS) {
+        return null;
+      }
+      let data = JSON.parse(text);
+      let version = data?.tag_name;
+      if (
+        typeof version != "string" ||
+        !VERSION_PATTERN.test(version) ||
+        data.draft ||
+        data.prerelease
+      ) {
+        return null;
+      }
+      Services.prefs.setStringPref(PREF_LATEST, version);
+      Services.prefs.setStringPref(PREF_LAST_CHECK, String(Date.now()));
+      return version;
+    } catch (ex) {
+      console.warn("ducksteps release check failed:", ex);
+      return null;
+    } finally {
+      lazy.clearTimeout(timer);
+    }
+  },
+
+  /**
+   * @returns {string|null}
+   *   The newest known version if it is newer than the running build.
+   */
+  getAvailableVersion() {
+    let latest = Services.prefs.getStringPref(PREF_LATEST, "");
+    if (!VERSION_PATTERN.test(latest)) {
+      return null;
+    }
+    return Services.vc.compare(latest, Services.appinfo.version) > 0
+      ? latest
+      : null;
+  },
+
+  getReleaseUrl(version) {
+    return VERSION_PATTERN.test(version) ? RELEASE_PAGE_BASE + version : null;
+  },
+
+  /**
+   * Runs a fresh check for the About dialog.
+   *
+   * @returns {Promise<{state: string, version?: string, url?: string}>}
+   *   state is "available", "current", "unknown" or "disabled".
+   */
+  async getStatus() {
+    if (!this.enabled) {
+      return { state: "disabled" };
+    }
+    let latest = await this.check({ notify: false });
+    let available = this.getAvailableVersion();
+    if (available) {
+      return {
+        state: "available",
+        version: available,
+        url: this.getReleaseUrl(available),
+      };
+    }
+    return { state: latest ? "current" : "unknown" };
+  },
+
+  async notifyIfNewer() {
+    let version = this.getAvailableVersion();
+    if (
+      !version ||
+      Services.prefs.getStringPref(PREF_DISMISSED, "") == version
+    ) {
+      return;
+    }
+    let win = lazy.BrowserWindowTracker.getTopWindow();
+    if (!win?.gNotificationBox) {
+      return;
+    }
+
+    let existing =
+      win.gNotificationBox.getNotificationWithValue(NOTIFICATION_ID);
+    if (existing) {
+      win.gNotificationBox.removeNotification(existing, true);
+    }
+
+    let dismiss = () => Services.prefs.setStringPref(PREF_DISMISSED, version);
+    await win.gNotificationBox.appendNotification(
+      NOTIFICATION_ID,
+      {
+        label: `ducksteps ${version} is available.`,
+        priority: win.gNotificationBox.PRIORITY_INFO_MEDIUM,
+        eventCallback(event) {
+          if (event == "dismissed") {
+            dismiss();
+          }
+        },
+      },
+      [
+        {
+          label: "Download",
+          accessKey: "D",
+          primary: true,
+          callback: () => {
+            win.openTrustedLinkIn(this.getReleaseUrl(version), "tab");
+          },
+        },
+        {
+          label: "Not now",
+          accessKey: "N",
+          callback: dismiss,
+        },
+      ]
+    );
+  },
+};
